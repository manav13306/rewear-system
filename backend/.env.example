# ReWear Clothing System - Environment Configuration Template
# Copy this file to .env and update with your own values

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True

# Database Configuration
# For SQLite (development):
DATABASE_URL=sqlite:///rewear.db

# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/rewear_db

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-key-change-in-production

# Server Configuration
HOST=0.0.0.0
PORT=5000

# File Upload
UPLOAD_FOLDER=uploads/
MAX_FILE_SIZE=16777216  # 16MB in bytes

# Sustainability Constants
CO2_PER_ITEM_KG=3.0
WATER_PER_ITEM_LITERS=7000
TEXTILE_WASTE_PER_ITEM_KG=0.5

# Email Configuration (for password reset, notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Admin Email
ADMIN_EMAIL=admin@rewear.com
